{
  "name": "webviews",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "index.js",
    "README.md",
    "CHANGELOG.md",
    "package.json"
  ],
  "scripts": {
    "clean": "rimraf --no-glob ./dist ./coverage ./tsconfig.tsbuildinfo",
    "lint": "eslint .",
    "test": "run-s test-unit",
    "test-unit": "vitest run --passWithNoTests",
    "test-unit-watch": "vitest watch --ui",
    "typecheck": "tsc --project ./tsconfig.json --noEmit",
    "lint-staged-files": "lint-staged --allow-empty",
    "ci:build": "npx flat ci buildEvolve",
    "ci:checkRequirements": "npx flat ci checkRequirements",
    "build": "npx flat build evolve",
    "serve": "npx flat serve evolve",
    "prepare": "yarn husky"
  },
  "dependencies": {
    "@dimjs/lang": "next",
    "@dimjs/logger": "next",
    "@dimjs/utils": "next",
    "@vscode/webview-ui-toolkit": "^1.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "use-intl": "3.17.6"
  },
  "devDependencies": {
    "@flatjs/cli": "2.1.4",
    "@flatjs/cli-plugin-ci": "2.1.4",
    "@flatjs/evolve-launch-editor": "2.1.0",
    "@hyperse/eslint-config-hyperse": "^1.1.3",
    "@types/node": "22.5.0",
    "@types/react": "18.3.4",
    "@types/react-dom": "18.3.0",
    "@types/vscode-webview": "^1.57.5",
    "cross-env": "7.0.3",
    "eslint": "^9.9.1",
    "husky": "9.1.5",
    "is-ci": "3.0.1",
    "lint-staged": "15.2.9",
    "npm-run-all": "4.1.5",
    "postcss": "8.4.41",
    "postcss-preset-env": "10.0.2",
    "react-dev-inspector": "^2.0.1",
    "rimraf": "6.0.1",
    "tailwind-merge": "^2.5.2",
    "tailwindcss": "3.4.10",
    "typescript": "5.5.4",
    "vite-tsconfig-paths": "^5.0.1",
    "vitest": "^2.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "yarn@4.3.0"
}
