{
  "extends": "@hyperse/eslint-config-hyperse/tsconfig.base.json",
  "compilerOptions": {
    "strict": false,
    "sourceMap": true,
    "noImplicitAny": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "baseUrl": ".",
    "rootDir": ".",
    "outDir": "dist",
  },
  "exclude": [
    "**/node_modules",
    "**/.*/"
  ]
}